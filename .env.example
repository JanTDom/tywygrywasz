# Server-only Supabase connection. Never expose the service role key as NEXT_PUBLIC_*.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

# Optional public URL used for origin checks and canonical links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Account-only verification/reset mail. No vault/document data is sent.
# Production requires HTTPS APP_URL and a verified sender domain in Resend.
AUTH_EMAIL_TRANSPORT=resend
APP_URL=https://tywygrywasz.pl
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional separate random secret; otherwise the server-only service-role key is used.
AUTH_RATE_LIMIT_SECRET=

# Przelewy24 (server-only; leave unset until seller verification is complete)
P24_ENV=sandbox
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_AMOUNT_GROSZ=
P24_OFFER_NAME=
P24_SELLER_NAME=
P24_SELLER_EMAIL=
P24_RETURN_URL=http://localhost:3000/platnosc
P24_STATUS_URL=http://localhost:3000/api/payments/webhook

# Public offer/legal details (keep the checkout disabled until complete)
COMMERCE_OFFER_NAME=TyWygrywasz — plan sprawy
COMMERCE_OFFER_DESCRIPTION=
COMMERCE_PRICE_GROSS_PLN=
COMMERCE_SELLER_NAME=
COMMERCE_SELLER_ADDRESS=
COMMERCE_SELLER_TAX_ID=
COMMERCE_SELLER_REGON=
COMMERCE_SELLER_EMAIL=
